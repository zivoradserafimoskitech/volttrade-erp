# Copy to .env.local and fill in. Supabase → Project Settings → API.
#
# Note the key name: the client reads VITE_SUPABASE_PUBLISHABLE_KEY, not
# VITE_SUPABASE_ANON_KEY. src/lib/volttrade.ts used to read the latter and
# threw "Missing Supabase environment variables" on every risk-module call
# whenever only the former was set; it now reads the same name as everything
# else, and the old name is kept below only as a fallback for existing
# deployments.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>

# Optional — only needed for the modules that use them.
VITE_VOLTTRADE_ANALYTICS_URL=https://volttrade-analytics.onrender.com
VITE_GATEWAY_UI_URL=https://<volttrade-cloud-host>
